# Ship a fix to one of the homeserver's RUNTIME scripts without reseeding.
#
# The corpus is the expensive, irreplaceable half of ribalba/parrot-matrixserver:
# room and event IDs are generated by Synapse at seeding time, cannot be made
# deterministic, and every chat-client recording is tied to the ones baked into
# the published image. So a fix to parrot-bot.py, start.sh, start-bot.sh or
# smoke_test.py must not go out as a rebuild unless the build cache still holds
# the seeding layer - and after a machine change, a prune, or a fresh builder, it
# does not.
#
# This layers the current scripts onto the published image instead. The corpus
# comes through untouched, byte for byte, because it is the base.
#
#   make patch-matrixserver        # build and load locally
#   make push-patched-matrixserver # build and push over the same tag
#
# Build context is applications/chatclients, the same as Dockerfile.
#
# NOT a substitute for a real rebuild when a build-time input changes -
# account.env, conf/, build.sh, setup.sh or seed_corpus.py. Those define the
# corpus, so they need `make matrixserver` and a MATRIX_TAG bump.
ARG MATRIX_IMAGE=ribalba/parrot-matrixserver
ARG MATRIX_TAG=v1
FROM ${MATRIX_IMAGE}:${MATRIX_TAG}

COPY matrixserver/start.sh matrixserver/start-bot.sh matrixserver/parrot-bot.py \
     matrixserver/smoke_test.py /opt/parrot/matrixserver/

RUN chmod +x /opt/parrot/matrixserver/*.sh /opt/parrot/matrixserver/*.py
