# Parrot chat-client benchmark - prebuilt Matrix homeserver.
#
# Bakes PostgreSQL, Synapse and the whole seeded corpus into an image, so a
# benchmark run only has to start two daemons instead of registering 500
# accounts and writing tens of thousands of events. That turns many minutes of
# setup per run into a few seconds.
#
# It also removes a reproducibility hole that has no other fix. Room and event
# IDs are generated by the server at seeding time and cannot be made
# deterministic: seed twice and you get two corpora that are identical in
# content and different in every identifier. Anything derived from those IDs -
# the manifest the smoke test checks, a client profile that pins a room - would
# be invalidated by a reseed. Baking the corpus once means every machine that
# pulls this image gets the same room IDs as the machine that recorded.
#
# Build from the applications/chatclients directory, so that account.env - the
# single source of truth the scripts read - is inside the build context:
#
#   make matrixserver          # build and load locally
#   make push-matrixserver     # build and push to the registry
#
# Bump MATRIX_TAG in the Makefile whenever the corpus changes; the tag is what
# the usage_scenario files pin.

FROM ubuntu@sha256:9cbed754112939e914291337b5e554b07ad7c392491dba6daf25eef1332a22e8

ENV DEBIAN_FRONTEND=noninteractive

# Lower these to build a smaller corpus for quick iteration. The history is by
# far the slowest part: every message is an HTTP round trip and a database
# write, so 40,000 of them dominate the build.
ARG PARROT_MATRIX_HISTORY=8000
ARG PARROT_MATRIX_PHOTOS=400
ARG PARROT_MATRIX_MEMBERS=500
ARG PARROT_MATRIX_FILLERS=60
ENV PARROT_MATRIX_HISTORY=${PARROT_MATRIX_HISTORY} \
    PARROT_MATRIX_PHOTOS=${PARROT_MATRIX_PHOTOS} \
    PARROT_MATRIX_MEMBERS=${PARROT_MATRIX_MEMBERS} \
    PARROT_MATRIX_FILLERS=${PARROT_MATRIX_FILLERS}

# Set to 1 to build without version pins and have build.sh print the versions
# it resolved. For bootstrapping only - never benchmark from an unpinned build.
ARG PARROT_ALLOW_UNPINNED=0
ENV PARROT_ALLOW_UNPINNED=${PARROT_ALLOW_UNPINNED}

# WHAT IS COPIED BEFORE THE SEEDING LAYER, AND WHAT IS COPIED AFTER IT.
#
# These four are inputs to build.sh, so editing one of them SHOULD produce a
# different corpus and SHOULD invalidate the layer below.
#
# account.env sits one level up from the scripts, which read it as
# ../account.env - so the layout inside the image has to mirror the repository.
COPY account.env /opt/parrot/account.env
COPY matrixserver/conf /opt/parrot/matrixserver/conf
COPY matrixserver/build.sh matrixserver/setup.sh matrixserver/seed_corpus.py \
     /opt/parrot/matrixserver/

RUN chmod +x /opt/parrot/matrixserver/*.sh /opt/parrot/matrixserver/*.py

# Packages, the database, the accounts, the configuration and the corpus.
RUN bash /opt/parrot/matrixserver/build.sh

# The runtime scripts come AFTER the corpus, and that ordering is the point.
# `COPY matrixserver /opt/parrot/matrixserver` used to sit above build.sh, so a
# one-line fix in parrot-bot.py invalidated the seeding layer and republishing
# it meant reseeding - which changes every room and event ID and invalidates the
# recordings, per the header. The consequence was that the published image kept
# an older parrot-bot.py than the repository: its startup /sync was not wrapped
# in with_retries(), so a Synapse that answered HTTP 500 while still warming up
# killed the run in BOOT.
#
# With the copy here, a fix to one of these four rebuilds two cheap layers ON
# TOP of the existing corpus - provided the build cache still holds it. When it
# does not, `make patch-matrixserver` gets the same result from the published
# image itself, which is the reliable way to ship a runtime-script fix.
COPY matrixserver/start.sh matrixserver/start-bot.sh matrixserver/parrot-bot.py \
     matrixserver/smoke_test.py /opt/parrot/matrixserver/

RUN chmod +x /opt/parrot/matrixserver/*.sh /opt/parrot/matrixserver/*.py

# Convenience entry points on PATH, so a usage_scenario setup-command does not
# need to know where the repository was mounted.
RUN ln -sf /opt/parrot/matrixserver/start.sh /usr/local/bin/parrot-matrixserver-start \
 && ln -sf /opt/parrot/matrixserver/smoke_test.py /usr/local/bin/parrot-matrixserver-smoke \
 && ln -sf /opt/parrot/matrixserver/start-bot.sh /usr/local/bin/parrot-bot-start

EXPOSE 8008

# The Green Metrics Tool keeps containers alive and drives them with exec, the
# same way ribalba/xwindow-server works, so the image must not exit.
CMD ["sleep", "inf"]
