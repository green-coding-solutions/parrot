# Single source of truth for the benchmark mail account.
#
# Sourced by the mail server scripts, by every client's seed script, and by the
# smoke test.  If you change the address or domain, regenerate the corpus - it
# embeds the address in every To: header.
#
# Every value is a DEFAULT: written as ${VAR:-...} so that anything already in
# the environment wins.  That is what makes `environment:` in a usage_scenario,
# a --build-arg, or an inline `PARROT_MAIL_TARGET_MB=100 ./setup.sh` take effect.
# Plain assignments here would silently override all three.

# The mailbox under test.
PARROT_MAIL_USER="${PARROT_MAIL_USER:-parrot}"
PARROT_MAIL_PASS="${PARROT_MAIL_PASS:-parrot}"
PARROT_MAIL_ADDRESS="${PARROT_MAIL_ADDRESS:-parrot@parrot.test}"
PARROT_MAIL_REALNAME="${PARROT_MAIL_REALNAME:-Robin Parrot}"
PARROT_MAIL_DOMAIN="${PARROT_MAIL_DOMAIN:-parrot.test}"

# Hostname of the mail container.  This resolves because every
# usage_scenario.yml declares it as a Docker network alias on the mail service,
# so the name a client connects to matches the TLS certificate's CN.
PARROT_MAIL_HOST="${PARROT_MAIL_HOST:-mail.parrot.test}"

# Transport security for the client account: none | starttls | tls
#
# The default is `none`, and that is a deliberate compromise.  It is the only
# setting all eight clients can be pre-configured for without a human accepting
# a self-signed certificate mid-measurement, so it keeps the comparison about
# the client rather than about whose trust dialog appears when.
#
# The server always offers all three, so switching this to `starttls` or `tls`
# benchmarks the TLS path instead - do it for every client or not at all, since
# TLS on a 500 MB sync is a real and unevenly distributed cost.
PARROT_MAIL_SECURITY="${PARROT_MAIL_SECURITY:-none}"

# IMAP: 143 plaintext/STARTTLS, 993 implicit TLS.
# Submission: 587 plaintext/STARTTLS, 465 implicit TLS.
PARROT_IMAP_PORT="${PARROT_IMAP_PORT:-143}"
PARROT_IMAPS_PORT="${PARROT_IMAPS_PORT:-993}"
PARROT_SUBMISSION_PORT="${PARROT_SUBMISSION_PORT:-587}"
PARROT_SMTPS_PORT="${PARROT_SMTPS_PORT:-465}"

# Size of the generated mailbox.  Lower it while iterating on a recording -
# generating the full corpus takes about three minutes.  The floor is roughly
# 75 MB: the message text alone is 50 MB and two anchor attachments are fixed.
PARROT_MAIL_TARGET_MB="${PARROT_MAIL_TARGET_MB:-500}"

# Where the mail container keeps its certificates.  Only meaningful inside the
# mail container; the client container obtains the CA certificate from the live
# TLS handshake instead of from a shared volume.
PARROT_CERT_DIR="${PARROT_CERT_DIR:-/etc/dovecot/private}"
